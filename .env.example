# Public API used by the JavaScript app. Use the computer's LAN IP for a
# physical device, or 10.0.2.2 for the standard Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Build-time secret used by the react-native-maps config plugin.
# Keep the real value in .env.local or the build service's secret store.
GOOGLE_MAPS_ANDROID_API_KEY=
